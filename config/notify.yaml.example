# GP助手推送配置（模板）
# 使用方式：复制为 config/notify.yaml 并填入你的凭证
#   cp config/notify.yaml.example config/notify.yaml

# 自选股池（定时诊断这些股票）
stock_pools:
  CN: ["600519", "000001"]
  US: ["AAPL", "TSLA"]
  HK: ["00700", "09988"]

# 启用的市场：只推送这些市场的分析（CN=A股 HK=港股 US=美股），可组合
enabled_markets: ["CN", "HK", "US"]

# 全市场扫描（与自选股诊断同时推送）
scan:
  enabled: true
  # 多头排列(新晋)=最近3日内新成立的排列，避免同一批趋势股每天重复置顶
  conditions: ["多头排列(新晋)", "MACD金叉", "突破新高", "放量", "超卖"]
  cn_pool: []
  cn_universe_limit: 300    # 0=扫全部A股(很慢)，建议 100-300；留空时按板块分层随机抽样，每天换一批
  us_pool: ["AAPL", "MSFT", "TSLA"]
  hk_pool: ["00700", "09988"]

# 收盘漏斗选股（自研四层，交易日 15:10 后自动跑一次全市场，替代随机抽样扫描）
funnel:
  enabled: true
  top_n: 10                 # 每天输出的关注池数量
  min_amount: 50000000      # L1 日成交额下限（元）
  min_market_cap: 50        # L2 总市值下限（亿元）
  pe_min: 0                 # L2 PE 区间（0 < PE < 100）
  pe_max: 100
  min_turnover: 0.3         # L2 换手率下限（%）
  l3_limit: 80              # L3 技术面后进入 L4 的候选数
  l3_conditions: ["多头排列(新晋)", "MACD金叉", "突破新高", "放量", "超卖", "RSI健康"]
  # L4 新闻风险层：近7天新闻/公告标题命中关键词则降分并标注（如 000056 的诉讼公告）
  news_enabled: true
  news_days: 7
  news_penalty: 15
  news_risk_keywords: ["诉讼", "立案", "减持", "质押", "冻结", "处罚", "违规", "问询",
                       "风险警示", "退市", "终止上市", "调查", "仲裁", "合同纠纷",
                       "业绩预亏", "商誉减值", "监管函", "关注函"]

# 交易监听：从 macOS 通知中心识别券商成交消息，自动同步持仓
# 使用前提：1) 系统设置→隐私与安全性→完全磁盘访问 给终端/IDE授权
#           2) 微信 Mac 保持登录在线；3) 同花顺/平安证券服务号开启交易提醒
# 入口：python examples/run_trade_monitor.py --once（或常驻）
trade_monitor:
  enabled: false            # 授权后改为 true（或直接用命令行启动）
  notify_db: ""                # 留空自动定位 ~/Library/Group Containers/group.com.apple.usernoted/db2/db
  whitelist_apps: ["com.tencent.xinWeChat"]   # 只处理微信的通知（前缀匹配）
  app_name_hint: ["同花顺", "平安证券", "成交", "委托"]  # 正文含这些词才解析，留空=全部
  auto_sync: true           # 解析成功是否自动写入持仓库
  poll_interval_sec: 30     # 常驻监听轮询间隔
  lookback_min: 2880        # 首次运行回溯最近多少分钟的通知（48h）
  keywords:
    buy: ["买入", "买进", "申购", "增持", "建仓"]
    sell: ["卖出", "卖出了", "赎回", "减持", "清仓"]

# 推送渠道（启用哪个填哪个的凭证）
notify:
  email:
    enabled: false
    smtp_host: "smtp.qq.com"
    smtp_port: 465           # SSL 端口；TLS 用 587
    use_ssl: true
    username: "YOUR_EMAIL@example.com"
    password: "YOUR_SMTP_AUTH_CODE"   # 授权码（非登录密码）
    sender_name: "GP助手"
    to: ["YOUR_EMAIL@example.com"]

  serverchan:                # Server酱 · 微信推送 https://sct.ftqq.com
    enabled: false
    sendkey: "YOUR_SERVERCHAN_SENDKEY"

  feishu:                    # 飞书自定义机器人
    enabled: false
    webhook: ""              # 群机器人 webhook 完整 URL
    secret: ""               # 签名校验密钥（启用加签才有，可留空）

# 调度频率（仅在对应市场交易时段内执行）
schedule:
  cn_interval_min: 60        # A股：每 60 分钟
  ushk_interval_min: 10      # 美股/港股：每 10 分钟
  us_winter: true            # true=冬令时(21:30)，false=夏令时(22:30)
  poll_interval_sec: 60      # 调度器主循环检查间隔


# AI 点评（可选）— OpenAI 兼容接口：DeepSeek / 硅基流动 / 通义兼容模式 / OpenAI
# 只根据本系统已算好的持仓与动作写人话，不替代买卖决策
ai:
  enabled: false
  api_key: ""                    # 或环境变量 QTS_AI_API_KEY
  base_url: "https://api.deepseek.com"   # 不要末尾 /v1
  model: "deepseek-chat"
  timeout: 60
  max_tokens: 1200
  temperature: 0.3
