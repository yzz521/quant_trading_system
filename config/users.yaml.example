# 复制为 config/users.yaml
enabled: true

# 登录保持时长（小时）。刷新页面不会退出，直到过期或点「退出登录」
# 建议 24～168（1～7 天）；最大约 90 天
session_ttl_hours: 168

# 用于签名 cookie 的密钥（请改成随机长字符串，勿提交到 git）
session_secret: "change-me-to-a-long-random-string"

users:
  - username: admin
    # 明文仅便于本地试用；生产请改用 password_hash
    password: "changeme"
    # password_hash: "8c000b0d131227ce0870037b162cff6bd85a37b4336ed9ab597e04057b336f3e"
    # salt: "qts-local"
